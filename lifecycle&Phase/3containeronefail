apiVersion: v1
kind: Pod
metadata:
  name: multi-container-test
spec:
  restartPolicy: Never
  containers:
  - name: success-container
    image: busybox
    command: ["sh", "-c", "echo SUCCESS && exit 0"]

  - name: fail-container
    image: busybox
    command: ["sh", "-c", "echo FAIL && exit 1"]

  - name: running-container
    image: nginx


#kubectl get pod multi-container-test -o jsonpath="{range .status.containerStatuses[*]}{.name} {.state.terminated.exitCode}{'\n'}{end}"
